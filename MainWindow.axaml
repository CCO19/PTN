<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PTN"
    x:Class="PTN.MainWindow"
    Title="Pas le Temps d'Niaiser !"
    Width="1050"
    Height="720"
    MinWidth="850"
    MinHeight="600"
    Background="#F4F6F8"
    RequestedThemeVariant="Light"
    Icon="/Assets/freebox.ico">

    <Window.Styles>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#202124"/>
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5F6368"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3C4043"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#202124"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FDE8E7"/>
            <Setter Property="Foreground" Value="#B42318"/>
        </Style>

        <!-- Bouton Télécharger actif -->
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- État désactivé : gris, y compris pour le bouton success -->
        <Style Selector="Button.success:disabled">
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DCE3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
        </Style>

    </Window.Styles>

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Margin="28">

        <!-- EN-TÊTE -->
        <StackPanel
            Grid.Row="0"
            Spacing="4"
            Margin="0,0,0,24">

            <TextBlock
                Classes="title"
                Text="Pas le Temps d'Niaiser !"/>

            <TextBlock
                Classes="subtitle"
                Text="Téléchargement de séries par lot depuis un partage Freebox"/>

        </StackPanel>

        <!-- ZONE DE CONFIGURATION -->
        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#DDE2E8"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,0,18">

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="8"
                ColumnSpacing="10">

                <!-- LIEN -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Classes="label"
                    Text="Lien du partage Freebox"/>

                <TextBox
                    Grid.Row="1"
                    Grid.Column="0"
                    x:Name="UrlBox"
                    Watermark="Colle ici le lien du partage Freebox de la série (ou de la saison)"/>

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    x:Name="PasteButton"
                    Classes="secondary"
                    Content="Coller"
                    Click="PasteButton_Click"/>

                <!-- DESTINATION -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Classes="label"
                    Text="Dossier de destination"
                    Margin="0,8,0,0"/>

                <TextBox
                    Grid.Row="3"
                    Grid.Column="0"
                    x:Name="DestinationBox"
                    Watermark="Dossier dans lequel télécharger les fichiers"/>

                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    x:Name="BrowseButton"
                    Classes="secondary"
                    Content="Parcourir..."
                    Click="BrowseButton_Click"/>

            </Grid>

        </Border>

        <!-- LISTE DES FICHIERS -->
        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#DDE2E8"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0">

            <Grid
                RowDefinitions="Auto,*">

                <!-- EN-TÊTE DU TABLEAU -->
                <Border
                    Grid.Row="0"
                    Background="#F8F9FA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">

                    <Grid
                        ColumnDefinitions="*,180,140">

                        <TextBlock
                            Grid.Column="0"
                            Classes="label"
                            Text="Épisode"/>

                        <TextBlock
                            Grid.Column="1"
                            Classes="label"
                            Text="Taille"/>

                        <TextBlock
                            Grid.Column="2"
                            Classes="label"
                            Text="Statut"/>

                    </Grid>

                </Border>

                <!-- FICHIERS -->
                <ListBox
                    Grid.Row="1"
                    x:Name="FilesList">

                    <ListBox.ItemTemplate>

                        <DataTemplate x:DataType="local:VideoFile">

                            <Grid
                                ColumnDefinitions="*,180,140"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding RelativePath}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding SizeText}"
                                    Foreground="#5F6368"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Status}"
                                    Foreground="#3C4043"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- BAS DE FENÊTRE -->
        <Grid
            Grid.Row="3"
            RowDefinitions="Auto"
            ColumnDefinitions="*,Auto"
            Margin="0,18,0,0">

            <!-- INFORMATIONS / PROGRESSION -->
            <StackPanel
                Grid.Column="0"
                Spacing="7"
                Margin="0,0,20,0">

                <TextBlock
                    x:Name="StatusText"
                    Text="Colle le lien Freebox dans le champ « Lien Freebox », puis clique sur « Analyser »."
                    Foreground="#4B5563"
                    TextWrapping="Wrap"/>

                <ProgressBar
                    x:Name="Progress"
                    Minimum="0"
                    Maximum="100"
                    Value="0"/>

                <TextBlock
                    x:Name="ProgressText"
                    Text=""
                    FontSize="12"
                    Foreground="#6B7280"/>

            </StackPanel>

            <!-- BOUTONS -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">

                <Button
                    x:Name="AnalyzeButton"
                    Classes="primary"
                    Content="Analyser"
                    Click="AnalyzeButton_Click"/>

                <Button
                    x:Name="ClearButton"
                    Classes="danger"
                    Content="Effacer"
                    Click="ClearButton_Click"/>

                <Button
                    x:Name="DownloadButton"
                    Classes="success"
                    Content="Télécharger"
                    IsEnabled="False"
                    Click="DownloadButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>